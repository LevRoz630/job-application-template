# Normalise line endings: treat all text files as LF in the repo and on checkout.
# Prevents the CRLF/LF churn that broke `git pull --rebase`.
* text=auto eol=lf

# Binary files — never apply text/EOL conversion.
*.pdf   binary
*.pptx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
